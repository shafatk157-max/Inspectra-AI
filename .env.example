# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_VISION_MODEL: Model to use for vision inspection (default: gemini-3.5-flash)
GEMINI_VISION_MODEL="gemini-3.5-flash"

# SUPABASE_URL: Project URL for Supabase (e.g. https://your-project.supabase.co)
# If left empty, the application activates Persistent Local Storage mode.
# NOTE: Local storage is ephemeral on Vercel. Configure Supabase for production.
SUPABASE_URL=""

# SUPABASE_ANON_KEY: Public anonymous key for client requests (not used server-side)
SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Privileged server key (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=""

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# Upload limit is capped at 4 MB to stay within Vercel's serverless body limit.
